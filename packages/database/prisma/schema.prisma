generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  CLAIMED
  REPORTED
  CLOSED
}

model Governorate {
  id         String     @id @default(uuid())
  /// Stable external identifier from an authoritative source (e.g. OCHA pcode, UN admin code).
  /// Nullable: records without a known external source have no externalId.
  externalId String?    @unique @map("external_id")
  nameAr     String     @map("name_ar")
  nameEn     String?    @map("name_en")
  code       String?    @unique
  districts  District[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("governorates")
}

model District {
  id            String                                 @id @default(uuid())
  /// Stable external identifier from an authoritative source (e.g. OCHA pcode, UN admin code).
  /// Nullable: records without a known external source have no externalId.
  externalId    String?                                @map("external_id")
  governorateId String                                 @map("governorate_id")
  governorate   Governorate                            @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  nameAr        String                                 @map("name_ar")
  nameEn        String?                                @map("name_en")
  code          String?
  boundary      Unsupported("geography(MultiPolygon, 4326)")?
  places        Place[]
  createdAt     DateTime                               @default(now()) @map("created_at")
  updatedAt     DateTime                               @updatedAt @map("updated_at")

  /// A district name must be unique within its governorate.
  /// District names are NOT assumed to be globally unique across Yemen.
  @@unique([governorateId, nameAr])
  /// External ID must be unique when provided — prevents duplicate import records.
  @@unique([externalId])
  @@index([boundary], type: Gist)
  @@map("districts")
}

model Category {
  id        String     @id @default(uuid())
  nameAr    String     @map("name_ar")
  nameEn    String?    @map("name_en")
  slug      String     @unique
  icon      String?
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  places    Place[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model Place {
  id                 String             @id @default(uuid())
  nameAr             String             @map("name_ar")
  nameEn             String?            @map("name_en")
  slug               String?            @unique
  description        String?
  address            String?
  phoneNumber        String?            @map("phone_number")
  website            String?
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  categoryId         String             @map("category_id")
  category           Category           @relation(fields: [categoryId], references: [id])
  districtId         String             @map("district_id")
  district           District           @relation(fields: [districtId], references: [id])
  businessId         String?            @map("business_id")
  business           Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)
  location           PlaceLocation?
  observations       PlaceObservation[]
  conflicts          DataConflict[]
  favorites          Favorite[]
  requests           ServiceRequest[]
  branchClaims       BranchClaim[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("places")
}

model PlaceLocation {
  id        String                                 @id @default(uuid())
  placeId   String                                 @unique @map("place_id")
  place     Place                                  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  geom      Unsupported("geography(Point, 4326)")?
  createdAt DateTime                               @default(now()) @map("created_at")
  updatedAt DateTime                               @updatedAt @map("updated_at")

  @@index([geom], type: Gist)
  @@map("place_locations")
}

model DataSource {
  id                String             @id @default(uuid())
  name              String
  type              String
  reliabilityWeight Float              @default(1.0) @map("reliability_weight")
  observations      PlaceObservation[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("data_sources")
}

model PlaceObservation {
  id              String                                 @id @default(uuid())
  placeId         String?                                @map("place_id")
  place           Place?                                 @relation(fields: [placeId], references: [id])
  dataSourceId    String                                 @map("data_source_id")
  dataSource      DataSource                             @relation(fields: [dataSourceId], references: [id])
  name            String?
  phone           String?
  categoryId      String?                                @map("category_id")
  latitude        Float?
  longitude       Float?
  geom            Unsupported("geography(Point, 4326)")?
  confidenceScore Float                                  @default(0.0) @map("confidence_score")
  status          String                                 @default("PENDING")
  discoveredAt    DateTime                               @default(now()) @map("discovered_at")
  createdAt       DateTime                               @default(now()) @map("created_at")
  updatedAt       DateTime                               @updatedAt @map("updated_at")

  @@index([geom], type: Gist)
  @@map("place_observations")
}

model DataConflict {
  id                       String    @id @default(uuid())
  placeId                  String    @map("place_id")
  place                    Place     @relation(fields: [placeId], references: [id])
  description              String
  baseObservationId        String    @map("base_observation_id")
  conflictingObservationId String    @map("conflicting_observation_id")
  status                   String    @default("OPEN")
  resolvedAt               DateTime? @map("resolved_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("data_conflicts")
}

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  passwordHash        String           @map("password_hash")
  role                String           @default("USER")
  sessions            Session[]
  favorites           Favorite[]
  requests            ServiceRequest[]
  businessMemberships   BusinessMember[]
  submittedBranchClaims BranchClaim[]     @relation("SubmittedBranchClaims")
  reviewedBranchClaims  BranchClaim[]     @relation("ReviewedBranchClaims")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String   @map("place_id")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
  @@map("favorites")
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId     String?       @map("place_id")
  place       Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
  title       String
  description String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([placeId])
  @@map("service_requests")
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum BusinessRole {
  OWNER
  MANAGER
  MEMBER
}

enum BusinessVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Business {
  id           String                @id @default(uuid())
  name         String
  slug         String?               @unique
  description  String?
  status       BusinessStatus        @default(ACTIVE)
  members      BusinessMember[]
  places       Place[]
  verification BusinessVerification?
  branchClaims BranchClaim[]
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@map("businesses")
}

model BusinessMember {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(MEMBER)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_members")
}

model BusinessVerification {
  id              String                     @id @default(uuid())
  businessId      String                     @unique @map("business_id")
  business        Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status          BusinessVerificationStatus @default(UNVERIFIED)
  notes           String?
  submittedAt     DateTime                   @default(now()) @map("submitted_at")
  reviewedAt      DateTime?                  @map("reviewed_at")
  rejectionReason String?                    @map("rejection_reason")
  reviewerId      String?                    @map("reviewer_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@map("business_verifications")
}

enum BranchClaimStatus {
  PENDING_REVIEW
  PENDING_DISPUTE
  APPROVED
  REJECTED
  CANCELLED
}

model BranchClaim {
  id              String            @id @default(uuid())
  businessId      String            @map("business_id")
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  placeId         String            @map("place_id")
  place           Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  claimantId      String            @map("claimant_id")
  claimant        User              @relation("SubmittedBranchClaims", fields: [claimantId], references: [id], onDelete: Cascade)
  status          BranchClaimStatus @default(PENDING_REVIEW)
  notes           String?
  reviewerId      String?           @map("reviewer_id")
  reviewer        User?             @relation("ReviewedBranchClaims", fields: [reviewerId], references: [id], onDelete: SetNull)
  rejectionReason String?           @map("rejection_reason")
  submittedAt     DateTime          @default(now()) @map("submitted_at")
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([placeId])
  @@index([claimantId])
  @@index([status])
  @@map("branch_claims")
}

