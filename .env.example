# Database Connection String
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/waynah_dev?schema=public"

# Environment Settings
NODE_ENV="development"
PORT=3000

# Security Foundation Secrets
# In Production, set INGESTION_API_KEY to a high-entropy secret (e.g., openssl rand -base64 32)
INGESTION_API_KEY="dev-ingestion-key-do-not-use-in-prod"

# CORS Allowed Origins (Comma separated in production)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PROTECTED=60
RATE_LIMIT_MAX_PUBLIC=300

# Web Application API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Supabase OAuth Configuration
